# Local development only. Replace every credential before deploying.
APP_ENV=development
APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=go_pulsa_db

# Use a random secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_HOURS=24

WORKER_COUNT=10
QUEUE_SIZE=1000
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_RETRY=3

# Used only by `go run ./cmd/seed` to create demo accounts.
# The seed does not overwrite existing account passwords.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_AGENT_PASSWORD=ChangeThisAgentPassword123!
SEED_AGENT_PIN=123456
